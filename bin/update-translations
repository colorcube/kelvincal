#!/usr/bin/env bash
# Extracts translatable strings into packages/kelvincal/gui/i18n/*.ts (lupdate) and compiles them to .qm (lrelease).
# Requires the Qt Linguist tools (Fedora: qt6-linguist).
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
I18N_DIR="${PROJECT_ROOT}/packages/kelvincal/gui/i18n"

find_tool() {
    local name
    for name in "pyside6-$1" "$1-qt6" "/usr/lib64/qt6/bin/$1" "$1"; do
        if command -v "${name}" >/dev/null 2>&1; then
            echo "${name}"
            return 0
        fi
    done
    echo "error: Qt '$1' not found (Fedora: sudo dnf install qt6-linguist)" >&2
    return 1
}

LUPDATE="$(find_tool lupdate)"
LRELEASE="$(find_tool lrelease)"

mapfile -t SOURCES < <(find "${PROJECT_ROOT}/packages" -name '*.py' -not -path '*/__pycache__/*' | sort)
for ts in "${I18N_DIR}"/kelvincal_*.ts; do
    "${LUPDATE}" -locations none "${SOURCES[@]}" -ts "${ts}"
    "${LRELEASE}" "${ts}" -qm "${ts%.ts}.qm"
done
