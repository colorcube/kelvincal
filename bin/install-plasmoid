#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
PLASMOID_SRC="${PROJECT_ROOT}/plasmoid/org.kde.plasma.kelvincal"
PLASMOID_DEST="${HOME}/.local/share/plasma/plasmoids/org.kde.plasma.kelvincal"
"${SCRIPT_DIR}/install-desktop"

if command -v kpackagetool6 >/dev/null 2>&1; then
    if kpackagetool6 -t Plasma/Applet -s org.kde.plasma.kelvincal >/dev/null 2>&1; then
        kpackagetool6 -t Plasma/Applet -u "${PLASMOID_SRC}"
    else
        kpackagetool6 -t Plasma/Applet -i "${PLASMOID_SRC}"
    fi
else
    mkdir -p "$(dirname "${PLASMOID_DEST}")"
    rm -rf "${PLASMOID_DEST}"
    cp -r "${PLASMOID_SRC}" "${PLASMOID_DEST}"
fi

echo "✓ Installed KDE Plasma 6 applet 'org.kde.plasma.kelvincal' into ${PLASMOID_DEST}"
echo "  To add it to your KDE Panel: Right-click your panel -> 'Add or Manage Widgets...' -> Search for 'KelvinCal'"
