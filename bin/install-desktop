#!/usr/bin/env bash
# Links kelvincal/kelvincal-cli into ~/.local/bin and installs the desktop entry.
# The desktop entry must exist under the app ID (de.colorcube.kelvincal.desktop), otherwise the
# XDG desktop portal rejects the app ("App info not found") and Plasma shows no icon/name.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
LOCAL_BIN="${HOME}/.local/bin"
APPS_DIR="${HOME}/.local/share/applications"

mkdir -p "${LOCAL_BIN}" "${APPS_DIR}"
for old in kcal-cli kcal-gui; do  # former program names
    if [ -L "${LOCAL_BIN}/${old}" ] && [[ "$(readlink "${LOCAL_BIN}/${old}")" == "${PROJECT_ROOT}/bin/"* ]]; then
        rm -f "${LOCAL_BIN}/${old}"
    fi
done
ln -sf "${PROJECT_ROOT}/bin/kelvincal-cli" "${LOCAL_BIN}/kelvincal-cli"
ln -sf "${PROJECT_ROOT}/bin/kelvincal" "${LOCAL_BIN}/kelvincal"
echo "✓ Linked kelvincal-cli and kelvincal into ${LOCAL_BIN}"

rm -f "${APPS_DIR}/org.kde.kelvincal.desktop"  # former app ID
install -m 644 "${PROJECT_ROOT}/share/applications/de.colorcube.kelvincal.desktop" "${APPS_DIR}/"
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "${APPS_DIR}" >/dev/null 2>&1 || true
fi
echo "✓ Installed desktop entry into ${APPS_DIR}"

ICON_ROOT="${HOME}/.local/share/icons/hicolor"
for size in scalable 16x16 22x22 symbolic; do
    for svg in "${PROJECT_ROOT}/share/icons/hicolor/${size}/apps/"*.svg; do
        mkdir -p "${ICON_ROOT}/${size}/apps"
        install -m 644 "${svg}" "${ICON_ROOT}/${size}/apps/"
    done
done
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t "${HOME}/.local/share/icons/hicolor" || true
fi
echo "✓ Installed app icons (scalable, 16/22 px, symbolic) into ${ICON_ROOT}"

NOTIFY_DIR="${HOME}/.local/share/knotifications6"
mkdir -p "${NOTIFY_DIR}"
install -m 644 "${PROJECT_ROOT}/share/knotifications6/kelvincal.notifyrc" "${NOTIFY_DIR}/"
echo "✓ Installed notification events into ${NOTIFY_DIR} (System Settings → Notifications → KelvinCal)"
