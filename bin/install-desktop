#!/usr/bin/env bash
# Links kcal-gui/kcal-cli into ~/.local/bin and installs the desktop entry.
# The desktop entry must exist under the app ID (de.colorcube.kelvincal.desktop), otherwise the
# XDG desktop portal rejects the app ("App info not found") and Plasma shows no icon/name.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
LOCAL_BIN="${HOME}/.local/bin"
APPS_DIR="${HOME}/.local/share/applications"

mkdir -p "${LOCAL_BIN}" "${APPS_DIR}"
ln -sf "${PROJECT_ROOT}/bin/kcal-cli" "${LOCAL_BIN}/kcal-cli"
ln -sf "${PROJECT_ROOT}/bin/kcal-gui" "${LOCAL_BIN}/kcal-gui"
echo "✓ Linked kcal-cli and kcal-gui into ${LOCAL_BIN}"

rm -f "${APPS_DIR}/org.kde.kelvincal.desktop"  # former app ID
install -m 644 "${PROJECT_ROOT}/share/applications/de.colorcube.kelvincal.desktop" "${APPS_DIR}/"
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "${APPS_DIR}" >/dev/null 2>&1 || true
fi
echo "✓ Installed desktop entry into ${APPS_DIR}"
